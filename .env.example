# manage-accounts-web-ui — variables de entorno
# Copiar a .env y ajustar los valores según el entorno de desarrollo.
# Convenciones ACC-17: cada backend tiene su propia base URL.

# Backend Java (accounts-java) — productos, presupuestos, inversiones
# Puerto real: server.port=8081, context-path=/api/v1 (application.properties)
NEXT_PUBLIC_JAVA_API_URL=http://localhost:8081

# Backend Node (accounts-node) — transacciones, categorías, auth
# Puerto real: PORT=3457, context-path=/api/v1 (src/config/index.ts)
NEXT_PUBLIC_NODE_API_URL=http://localhost:3457

# Kanban local (manage-accounts-board) — solo herramienta de gestión, no es API de negocio
# Puerto real: PORT=3456 (server/index.ts)
NEXT_PUBLIC_KANBAN_API_URL=http://localhost:3456